<div id="app"
     data-controller="music-theory"
     data-music-theory-instrument-value="<%= @instrument %>"
     data-music-theory-mode-value="<%= @mode %>"
     data-music-theory-root-value="<%= @root %>"
     data-music-theory-name-value="<%= @name %>">

  <div class="controls">
    <select data-music-theory-target="instrument" data-action="change->music-theory#onInstrument"></select>

    <select data-music-theory-target="mode" data-action="change->music-theory#onMode">
      <option value="scale">Scales</option>
      <option value="chord">Chords</option>
      <option value="notes">Notes</option>
    </select>

    <select data-music-theory-target="root" data-action="change->music-theory#onRoot"></select>

    <select data-music-theory-target="name" data-action="change->music-theory#onName"></select>

    <button data-action="click->music-theory#toggleAccidental" data-music-theory-target="accidental">♯ / ♭</button>

    <button data-action="click->music-theory#toggleOctaves" data-music-theory-target="octaves">1 Octave</button>
  </div>

  <canvas data-music-theory-target="canvas"></canvas>
</div>
