<div id="app"
     data-controller="music-theory"
     data-music-theory-instrument-value="<%= @instrument %>"
     data-music-theory-mode-value="<%= @mode %>"
     data-music-theory-root-value="<%= @root %>"
     data-music-theory-name-value="<%= @name %>">

  <div class="controls">
    <select data-music-theory-target="instrument" data-action="change->music-theory#onInstrument"></select>

    <select data-music-theory-target="tuning" data-action="change->music-theory#onTuning"></select>

    <select data-music-theory-target="mode" data-action="change->music-theory#onMode">
      <option value="scale">Scales</option>
      <option value="chord">Chords</option>
      <option value="notes">Notes</option>
    </select>

    <select data-music-theory-target="root" data-action="change->music-theory#onRoot"></select>

    <select data-music-theory-target="name" data-action="change->music-theory#onName"></select>

    <button data-action="click->music-theory#toggleAccidental" data-music-theory-target="accidental">♯ / ♭</button>

    <button data-action="click->music-theory#toggleOctaves" data-music-theory-target="octaves">1 Octave</button>

    <button data-action="click->music-theory#toggleLabels" data-music-theory-target="labels">Names</button>

    <button data-action="click->music-theory#onPlay" data-music-theory-target="play">▶ Play</button>
  </div>

  <div class="diatonic" data-music-theory-target="diatonic"></div>

  <canvas data-music-theory-target="canvas"></canvas>
</div>

<style>
  /* Responsive: let #app shrink inside the flex layout, scale the canvas to fit,
     and wrap the controls. Touch taps already map correctly (the click handler
     scales client coords by canvas.width/rect.width). */
  #app { flex: 1 1 auto; min-width: 0; width: 100%; }
  canvas { max-width: 100%; height: auto; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px; }
  .controls select, .controls button { font: inherit; padding: 4px 8px; }
  @media (max-width: 640px) {
    main { margin-top: 1.25rem !important; padding-left: 12px !important; padding-right: 12px !important; }
  }

  .diatonic { display: flex; gap: 8px; margin: 8px 0 12px; flex-wrap: wrap; }
  .diatonic:empty { display: none; }
  .diatonic button {
    display: flex; flex-direction: column; align-items: center; min-width: 52px;
    padding: 6px 10px; border: 1px solid #ccc; border-radius: 6px;
    background: #fafafa; cursor: pointer; font: inherit; line-height: 1.2;
  }
  .diatonic button:hover { background: #eef4ff; border-color: #8ec3ff; }
  .diatonic button .roman { font-weight: 600; font-size: 0.95em; }
  .diatonic button .chord { color: #555; font-size: 0.85em; }
</style>
